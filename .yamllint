---
extends: default
rules:
  # Line length
  line-length:
    max: 120
    level: warning

  # Indentation
  indentation:
    spaces: 2
    indent-sequences: true

  # Comments
  comments:
    min-spaces-from-content: 1

  # Truthy values (allow unquoted yes/no)
  truthy: false

  # Don't require document start marker (---)
  document-start: disable

  # Require a newline at end of file
  new-line-at-end-of-file: {}

  # No trailing whitespace
  trailing-spaces: {}

  # Multiple documents in single file
  document-end: disable
