#!/bin/bash
# FreeCAD 3MF Export - Manual trigger
# Called via: pre-commit run --hook-stage manual freecad-export-manual
# Entry point is relative to freecad_tools repo root

# Get freecad_tools repo root (parent of hooks directory)
TOOLS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Get the project root (where .git is)
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

if [ -z "$PROJECT_ROOT" ]; then
    echo "Error: Not in a git repository" >&2
    exit 1
fi

# Change to project root and run export.
# $@ forwards any args from the caller (e.g. --config .freecad_tools/export.yml)
cd "$PROJECT_ROOT"
python3 "$TOOLS_ROOT/tools/fc_export.py" "$@"
