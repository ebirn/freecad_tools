# Minimal direnv configuration
if ! command -v uv >/dev/null 2>&1; then
    echo "uv not found. Please install uv to use this .envrc."
    exit 1
fi

# Create virtual environment if missing or outdated
if [ ! -d ".venv" ] || [ -z "$(find .venv -mtime -1)" ]; then
    echo "Creating/updating Python virtual env..."
    uv venv .venv
    uv sync
fi

# Activate the env
source .venv/bin/activate

# Install pre-commit hooks into git
if ! command -v pre-commit >/dev/null 2>&1; then
    echo "Installing pre-commit framework..."
    pip install pre-commit
fi

if [ ! -d ".git" ]; then
    echo "Not a git repository. Skipping pre-commit hook installation."
else
    echo "Installing pre-commit hooks..."
    pre-commit install
    pre-commit install --hook-type pre-push
    echo "✓ Pre-commit hooks installed successfully"
fi
