# Minimal direnv configuration
if ! command -v uv >/dev/null 2>&1; then
    echo "uv not found. Please install uv to use this .envrc."
    exit 1
fi

# Create virtual environment if missing or outdated
if [ ! -d ".venv" ] || [ -z "$(find .venv -mtime -1)" ]; then
    echo "Creating/updating Python virtual env..."
    uv venv .venv
    uv sync
fi

# Activate the env
source .venv/bin/activate
